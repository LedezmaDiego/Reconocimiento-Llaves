{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar proyecto (PocketBase + FastAPI)",
      "type": "shell",
      "command": "./iniciar.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Detener proyecto",
      "type": "shell",
      "command": "./iniciar.sh --parar",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Build Frontend",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Smoke test",
      "type": "shell",
      "command": "source venv/bin/activate && python scripts/smoke_test.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
